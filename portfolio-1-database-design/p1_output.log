==> Structure evidence (constraints and triggers)
                                                        Table "public.lesson_session"
     Column     |           Type           | Collation | Nullable |                                 Default                                  
----------------+--------------------------+-----------+----------+--------------------------------------------------------------------------
 session_id     | integer                  |           | not null | nextval('lesson_session_session_id_seq'::regclass)
 pool_id        | integer                  |           | not null | 
 lane_id        | integer                  |           | not null | 
 instructor_id  | integer                  |           | not null | 
 lesson_type_id | integer                  |           | not null | 
 start_time     | timestamp with time zone |           | not null | 
 end_time       | timestamp with time zone |           | not null | 
 duration_min   | integer                  |           | not null | 
 price          | numeric(10,2)            |           | not null | 
 during         | tstzrange                |           |          | generated always as (tstzrange(start_time, end_time, '[)'::text)) stored
Indexes:
    "lesson_session_pkey" PRIMARY KEY, btree (session_id)
    "excl_instructor_overlap" EXCLUDE USING gist (instructor_id WITH =, during WITH &&)
    "excl_lane_overlap" EXCLUDE USING gist (lane_id WITH =, during WITH &&)
Check constraints:
    "lesson_session_check" CHECK (end_time > start_time)
    "lesson_session_check1" CHECK (EXTRACT(epoch FROM end_time - start_time)::integer >= 1800 AND EXTRACT(epoch FROM end_time - start_time)::integer <= 3600)
    "lesson_session_duration_min_check" CHECK (duration_min >= 30 AND duration_min <= 60)
    "lesson_session_end_time_check" CHECK ((end_time AT TIME ZONE 'Africa/Lagos'::text)::time without time zone <= '20:00:00'::time without time zone)
    "lesson_session_price_check" CHECK (price > 0::numeric)
    "lesson_session_start_time_check" CHECK ((start_time AT TIME ZONE 'Africa/Lagos'::text)::time without time zone >= '06:00:00'::time without time zone)
Foreign-key constraints:
    "lesson_session_instructor_id_fkey" FOREIGN KEY (instructor_id) REFERENCES instructor(instructor_id)
    "lesson_session_lane_id_fkey" FOREIGN KEY (lane_id) REFERENCES lane(lane_id)
    "lesson_session_lesson_type_id_fkey" FOREIGN KEY (lesson_type_id) REFERENCES lesson_type(lesson_type_id)
    "lesson_session_pool_id_fkey" FOREIGN KEY (pool_id) REFERENCES pool(pool_id)
Referenced by:
    TABLE "enrolment" CONSTRAINT "enrolment_session_id_fkey" FOREIGN KEY (session_id) REFERENCES lesson_session(session_id) ON DELETE CASCADE
Triggers:
    trg_session_lane_pool BEFORE INSERT OR UPDATE ON lesson_session FOR EACH ROW EXECUTE FUNCTION enforce_session_lane_pool()

                                   Table "public.swimmer"
   Column    |  Type   | Collation | Nullable |                   Default                   
-------------+---------+-----------+----------+---------------------------------------------
 swimmer_id  | integer |           | not null | nextval('swimmer_swimmer_id_seq'::regclass)
 first_name  | text    |           | not null | 
 last_name   | text    |           | not null | 
 dob         | date    |           | not null | 
 age_class   | text    |           | not null | 
 phone       | text    |           |          | 
 email       | text    |           |          | 
 guardian_id | integer |           |          | 
Indexes:
    "swimmer_pkey" PRIMARY KEY, btree (swimmer_id)
Check constraints:
    "swimmer_age_class_check" CHECK (age_class = ANY (ARRAY['Child'::text, 'Teen'::text, 'Adult'::text, 'Senior'::text]))
Foreign-key constraints:
    "swimmer_guardian_id_fkey" FOREIGN KEY (guardian_id) REFERENCES guardian(guardian_id)
Referenced by:
    TABLE "enrolment" CONSTRAINT "enrolment_swimmer_id_fkey" FOREIGN KEY (swimmer_id) REFERENCES swimmer(swimmer_id)
Triggers:
    trg_swimmer_guardian BEFORE INSERT OR UPDATE ON swimmer FOR EACH ROW EXECUTE FUNCTION enforce_swimmer_guardian()

                                             Table "public.enrolment"
    Column    |           Type           | Collation | Nullable |                     Default                     
--------------+--------------------------+-----------+----------+-------------------------------------------------
 enrolment_id | integer                  |           | not null | nextval('enrolment_enrolment_id_seq'::regclass)
 session_id   | integer                  |           | not null | 
 swimmer_id   | integer                  |           | not null | 
 enrol_date   | timestamp with time zone |           | not null | CURRENT_TIMESTAMP
 status       | text                     |           | not null | 'confirmed'::text
 attended     | boolean                  |           |          | 
Indexes:
    "enrolment_pkey" PRIMARY KEY, btree (enrolment_id)
    "enrolment_session_id_swimmer_id_key" UNIQUE CONSTRAINT, btree (session_id, swimmer_id)
Check constraints:
    "enrolment_status_check" CHECK (status = ANY (ARRAY['confirmed'::text, 'cancelled'::text, 'attended'::text, 'no_show'::text]))
Foreign-key constraints:
    "enrolment_session_id_fkey" FOREIGN KEY (session_id) REFERENCES lesson_session(session_id) ON DELETE CASCADE
    "enrolment_swimmer_id_fkey" FOREIGN KEY (swimmer_id) REFERENCES swimmer(swimmer_id)
Referenced by:
    TABLE "payment" CONSTRAINT "payment_enrolment_id_fkey" FOREIGN KEY (enrolment_id) REFERENCES enrolment(enrolment_id) ON DELETE CASCADE
Triggers:
    trg_group_capacity BEFORE INSERT OR UPDATE ON enrolment FOR EACH ROW EXECUTE FUNCTION enforce_group_capacity()


