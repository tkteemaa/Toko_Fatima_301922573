                                                  Partitioned table "public.lesson_session"
     Column     |           Type           | Collation | Nullable |                                 Default                                  
----------------+--------------------------+-----------+----------+--------------------------------------------------------------------------
 session_id     | integer                  |           | not null | nextval('lesson_session_part_session_id_seq'::regclass)
 pool_id        | integer                  |           | not null | 
 lane_id        | integer                  |           | not null | 
 instructor_id  | integer                  |           | not null | 
 lesson_type_id | integer                  |           | not null | 
 start_time     | timestamp with time zone |           | not null | 
 end_time       | timestamp with time zone |           | not null | 
 duration_min   | integer                  |           | not null | 
 price          | numeric(10,2)            |           | not null | 
 during         | tstzrange                |           |          | generated always as (tstzrange(start_time, end_time, '[)'::text)) stored
Partition key: RANGE (start_time)
Indexes:
    "lesson_session_part_pkey" PRIMARY KEY, btree (session_id, start_time)
Check constraints:
    "lesson_session_part_check" CHECK (end_time > start_time)
    "lesson_session_part_check1" CHECK (EXTRACT(epoch FROM end_time - start_time)::integer >= 1800 AND EXTRACT(epoch FROM end_time - start_time)::integer <= 3600)
    "lesson_session_part_duration_min_check" CHECK (duration_min >= 30 AND duration_min <= 60)
    "lesson_session_part_end_time_check" CHECK ((end_time AT TIME ZONE 'Africa/Lagos'::text)::time without time zone <= '20:00:00'::time without time zone)
    "lesson_session_part_price_check" CHECK (price > 0::numeric)
    "lesson_session_part_start_time_check" CHECK ((start_time AT TIME ZONE 'Africa/Lagos'::text)::time without time zone >= '06:00:00'::time without time zone)
Foreign-key constraints:
    "lesson_session_part_instructor_id_fkey" FOREIGN KEY (instructor_id) REFERENCES instructor(instructor_id)
    "lesson_session_part_lane_id_fkey" FOREIGN KEY (lane_id) REFERENCES lane(lane_id)
    "lesson_session_part_lesson_type_id_fkey" FOREIGN KEY (lesson_type_id) REFERENCES lesson_type(lesson_type_id)
    "lesson_session_part_pool_id_fkey" FOREIGN KEY (pool_id) REFERENCES pool(pool_id)
Triggers:
    trg_session_lane_pool BEFORE INSERT OR UPDATE ON lesson_session FOR EACH ROW EXECUTE FUNCTION enforce_session_lane_pool()
